\draw (27.230, 8.400) -- (29.700, 8.400) node[osquarepole]{} node[right=5pt] {$V_{IN1}$};

% M3, M4
\node[nmos] (M3) at (21.750, 4.900) {};
\node[left] at (20.250, 4.900) {M3};
\node[nmos, xscale=-1] (M4) at (26.250, 4.900) {};
\node[right] at (27.750, 4.900) {M4};

\draw (21.750, 7.630) -- (21.750, 5.670);
\draw (26.250, 7.630) -- (26.250, 5.670);

\draw (21.750, 4.130) to[R, l_=$R_{11}$] (21.750, 0.700) node[ground]{};
\draw (26.250, 4.130) to[R, l_=$R_{12}$] (26.250, 0.700) node[ground]{};

% Bias from M12
\draw (13.730, 4.900) -- (27.230, 4.900);
\node[circ] at (13.730, 4.900) {};
\node[circ] at (20.770, 4.900) {};

% 1st-stage Label
\draw (21.750, -0.700) -- (21.750, -1.120) -- (26.250, -1.120) -- (26.250, -0.700);
\node[below] at (24.000, -1.120) {\textbf{1st-stage}};

% V_LV Rail
\draw (30.000, 14.000) -- (49.500, 14.000);
\node[above] at (39.750, 14.000) {$V_{LV}$};

% 2nd-stage
\node[pmos, emptycircle] (M13) at (32.250, 11.900) {};
