% Thick Oxide Transistors
\node[pmos, emptycircle] (M14) at (3.750, 11.900) {};
\node[above] at (3.750, 13.020) {M14};
\draw (3.750, 12.670) -- (3.750, 14.000);
\node[circ] at (3.750, 14.000) {};

\node[pmos, emptycircle] (M15) at (9.750, 11.900) {};
\node[above] at (9.750, 13.020) {M15};
\draw (9.750, 12.670) -- (9.750, 14.000);
\node[circ] at (9.750, 14.000) {};

\node[pmos, emptycircle] (M16) at (24.000, 11.900) {};
