\node[circ] at (45.230, 8.400) {};

% C11, C12
\draw (37.270, 8.400) to[C, l=$C_{11}$] (33.750, 8.400) node[osquarepole]{} node[left=5pt] {$V_{IN1}$};
\draw (45.230, 8.400) to[C, l=$C_{12}$] (48.750, 8.400) node[osquarepole]{} node[right=5pt] {$V_{IP1}$};

% M5, M6
\node[nmos] (M5) at (38.250, 3.500) {};
\node[right] at (39.750, 3.500) {M5};
\node[nmos, xscale=-1] (M6) at (44.250, 3.500) {};
