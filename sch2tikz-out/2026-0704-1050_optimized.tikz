\draw (3.750, 11.130) -- (2.770, 11.130) -- (2.770, 11.900);
\node[circ] at (2.770, 11.900) {};
\draw (2.770, 11.900) -- (23.020, 11.900);
\node[circ] at (8.770, 11.900) {};
\node[circ] at (23.020, 11.900) {};

% CMFB Stage (M9, M10)
\node[pmos, emptycircle] (M9) at (6.750, 8.400) {};
\node[right] at (8.250, 8.400) {M9};
\node[pmos, emptycircle, xscale=-1] (M10) at (12.750, 8.400) {};
\node[left] at (11.250, 8.400) {M10};

% M15 drain to M9, M10 sources
\draw (9.750, 11.130) -- (9.750, 10.080);
\draw (6.750, 9.170) -- (6.750, 10.080) -- (12.750, 10.080) -- (12.750, 9.170);
\node[circ] at (9.750, 10.080) {};

% V_CM Terminal
\draw (5.770, 8.400) -- (2.250, 8.400) node[osquarepole]{} node[left=5pt] {$V_{CM}$};

% M11, M12
\node[nmos] (M11) at (6.750, 4.900) {};
\node[right] at (8.250, 4.900) {M11};
\node[nmos, xscale=-1] (M12) at (12.750, 4.900) {};
\node[left] at (11.250, 4.900) {M12};

\draw (6.750, 7.630) -- (6.750, 5.670);
\draw (12.750, 7.630) -- (12.750, 5.670);

\draw (6.750, 5.670) -- (5.770, 5.670) -- (5.770, 4.900);
\draw (12.750, 5.670) -- (13.730, 5.670) -- (13.730, 4.900);

\draw (6.750, 4.130) to[R, l_=$R_{15}$] (6.750, 0.700) node[ground]{};
\draw (12.750, 4.130) to[R, l_=$R_{16}$] (12.750, 0.700) node[ground]{};

% CMFB Label
\draw (6.750, -0.700) -- (6.750, -1.120) -- (12.750, -1.120) -- (12.750, -0.700);
\node[below] at (9.750, -1.120) {\textbf{CMFB}};

% Voltage Divider
\draw (13.730, 8.400) -- (15.750, 8.400);
\node[circ] at (15.750, 8.400) {};
\draw (15.750, 8.400) -- (15.000, 8.400) to[R] (15.000, 10.500) -- (15.750, 10.500);
\draw (15.750, 8.400) -- (16.500, 8.400) to[C] (16.500, 10.500) -- (15.750, 10.500);
\node[above] at (15.750, 10.500) {$V_{OP1}$};

\draw (15.750, 8.400) -- (15.000, 8.400) to[R] (15.000, 6.300) -- (15.750, 6.300);
\draw (15.750, 8.400) -- (16.500, 8.400) to[C] (16.500, 6.300) -- (15.750, 6.300);
\node[below] at (15.750, 6.300) {$V_{ON1}$};

% 1st-stage
\node[pmos, emptycircle] (M1) at (21.750, 8.400) {};
