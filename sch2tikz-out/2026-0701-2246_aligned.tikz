\documentclass{standalone}
\usepackage[siunitx, american]{circuitikz}
\usepackage{tikz}
\usetikzlibrary{calc}
\begin{document}
\begin{circuitikz}[american, scale=1.0, every node/.style={transform shape}]

% --- Thick Oxide Stage ---
% Power rail V_HV
\draw (-0.050, 11.690) -- (20.250, 11.690);
\node[above] at (10.550, 11.690) {\small $V_{HV}$};

% Transistors
\node[pmos, emptycircle] (M14) at (2.400, 10.290) {};
\node[pmos, emptycircle] (M15) at (6.800, 10.290) {};
\node[pmos, emptycircle] (M16) at (16.940, 10.290) {};

\node[anchor=east] at (0.700, 10.290) {\small M14};
\node[anchor=south] at (6.800, 11.620) {\small M15};
\node[anchor=south] at (16.940, 11.620) {\small M16};

% Connections to V_HV
\draw (2.400, 11.270) -- (2.400, 11.690);
\draw (6.800, 11.270) -- (6.800, 11.690);
\draw (16.940, 11.270) -- (16.940, 11.690);

% Gate connection line
\draw (M14.G) -- (M16.G);

% Diode connection for M14
\draw (M14.G) -- (0.600, 10.290);
\draw (0.600, 10.290) -- (0.600, 9.730);
\draw (0.600, 9.730) -- (2.400, 9.730);
\node[circ] at (2.400, 9.730) {};

% Current source under M14
\draw (2.400, 9.730) to[I] (2.400, 7.280);
\draw (2.400, 7.280) node[ground] {};

% Thick Oxide box
\draw (-0.050, 8.190) -- (18.750, 8.190);
\draw (18.750, 8.190) -- (18.750, 12.390);
\draw (18.750, 12.390) -- (-0.050, 12.390);
\draw (-0.050, 12.390) -- (-0.050, 8.190);
\node[anchor=north west] at (0.800, 12.460) {\small \textbf{Thick Oxide}};


% --- CMFB Stage ---
% Transistors
\node[pmos, emptycircle] (M9) at (3.700, 6.790) {};
\node[pmos, emptycircle, xscale=-1] (M10) at (8.850, 6.790) {};
\node[nmos] (M11) at (3.700, 3.290) {};
\node[nmos] (M12) at (8.850, 3.290) {};

\node[anchor=south] at (3.700, 8.120) {\small M9};
\node[anchor=south] at (8.850, 8.120) {\small M10};
\node[anchor=north] at (3.700, 2.240) {\small M11};
\node[anchor=north] at (8.850, 2.240) {\small M12};

% Sources of M9 and M10
\draw (M9.S) -- (M10.S);
\node[circ] at (6.800, 7.770) {};
\draw (M15.D) -- (6.800, 7.770);

% Input V_CM to M9
\draw (M9.G) -- (1.450, 6.790);
\node[osquarepole] at (1.450, 6.790) {};
\node[anchor=east] at (1.350, 6.790) {\small $V_{CM}$};

% Resistors R15, R16
\draw (M11.S) to[R=$R_{15}$] (3.700, 0.700);
\draw (3.700, 0.700) node[ground] {};
\draw (M12.S) to[R=$R_{16}$] (8.850, 0.700);
\draw (8.850, 0.700) node[ground] {};

% Diode connection for M11
\draw (M11.G) -- (2.250, 3.290);
\draw (2.250, 3.290) -- (2.250, 4.270);
\draw (2.250, 4.270) -- (3.700, 4.270);
\node[circ] at (3.700, 4.270) {};

% Connection from M9 drain to M11 drain
\draw (M9.D) -- (M11.D);

% Connection from M10 drain to M12 drain
\draw (M10.D) -- (M12.D);

% Gate connection of M11 and M12 (under the transistor body)
\draw (M11.G) -- (2.250, 3.290);
\draw (2.250, 3.290) -- (2.250, 2.660);
\draw (2.250, 2.660) -- (7.380, 2.660);
\draw (7.380, 2.660) -- (M12.G);

% RC sensing network for M10
\draw (M10.G) -- (11.200, 6.790);
\node[circ] at (11.200, 6.790) {};
% Top branch to V_OP1
\draw (11.200, 6.790) -- (11.200, 7.280);
\draw (11.200, 7.280) -- (10.450, 7.280);
\draw (10.450, 7.280) to[R] (10.450, 8.190);
\draw (10.450, 8.190) -- (11.200, 8.190);
\draw (11.200, 7.280) -- (11.690, 7.280);
\draw (11.690, 7.280) to[C] (11.690, 8.190);
\draw (11.690, 8.190) -- (11.200, 8.190);
\draw (11.200, 8.190) -- (11.200, 8.960);
\node[osquarepole] at (11.200, 8.960) {};
\node[anchor=south] at (11.200, 9.380) {\small $V_{OP1}$};
% Bottom branch to V_ON1
\draw (11.200, 6.790) -- (11.200, 6.720);
\draw (11.200, 6.720) -- (10.450, 6.720);
\draw (10.450, 6.720) to[R] (10.450, 5.390);
\draw (10.450, 5.390) -- (11.200, 5.390);
\draw (11.200, 6.720) -- (11.690, 6.720);
\draw (11.690, 6.720) to[C] (11.690, 5.390);
\draw (11.690, 5.390) -- (11.200, 5.390);
\draw (11.200, 5.390) -- (11.200, 5.040);
\node[osquarepole] at (11.200, 5.040) {};
\node[anchor=north] at (11.200, 4.620) {\small $V_{ON1}$};


% --- 1st-Stage ---
% Transistors
\node[pmos, emptycircle] (M1) at (16.500, 6.790) {};
\node[pmos, emptycircle, xscale=-1] (M2) at (22.500, 6.790) {};
\node[nmos] (M3) at (16.500, 3.290) {};
\node[nmos] (M4) at (22.500, 3.290) {};

\node[anchor=south] at (16.500, 8.120) {\small M1};
\node[anchor=south] at (22.500, 8.120) {\small M2};
\node[anchor=north] at (16.500, 2.240) {\small M3};
\node[anchor=north] at (22.500, 2.240) {\small M4};

% Sources of M1 and M2
\draw (M1.S) -- (M2.S);
\node[circ] at (19.500, 7.770) {};
\draw (M16.D) -- (19.500, 7.770);

% Input V_IP1 and V_IN1 to gates
\draw (M1.G) -- (14.250, 6.790);
\node[osquarepole] at (14.250, 6.790) {};
\node[anchor=south] at (14.250, 7.560) {\small $V_{IP1}$};
\draw (M2.G) -- (24.750, 6.790);
\node[osquarepole] at (24.750, 6.790) {};
\node[anchor=south] at (24.750, 7.560) {\small $V_{IN1}$};

% Resistors R11, R12
\draw (M3.S) to[R=$R_{11}$] (16.500, 0.700);
\draw (16.500, 0.700) node[ground] {};
\draw (M4.S) to[R=$R_{12}$] (22.500, 0.700);
\draw (22.500, 0.700) node[ground] {};

% Gates of M3 and M4 connected together (under transistor bodies)
\draw (M3.G) -- (15.520, 2.660);
\draw (15.520, 2.660) -- (21.520, 2.660);
\draw (21.520, 2.660) -- (M4.G);

% Connection from M12 drain (CMFB output) to gates of M3/M4
\node[circ] at (8.850, 4.270) {};
\draw (8.850, 4.270) -- (10.550, 4.270);
\draw (10.550, 4.270) -- (10.550, 2.660);
\draw (10.550, 2.660) -- (15.520, 2.660);


% --- 2nd-Stage ---
% Power rail V_LV
\draw (22.500, 11.690) -- (33.000, 11.690);
\node[above] at (24.750, 11.690) {\small $V_{LV}$};

% Transistors
\node[pmos, emptycircle] (M13) at (26.690, 10.290) {};
\node[pmos, emptycircle] (M7) at (31.500, 6.790) {};
\node[pmos, emptycircle, xscale=-1] (M8) at (35.100, 6.790) {};
\node[nmos] (M5) at (31.500, 3.290) {};
\node[nmos] (M6) at (35.100, 3.290) {};

\node[anchor=south] at (26.690, 11.620) {\small M13};
\node[anchor=south] at (31.500, 8.120) {\small M7};
\node[anchor=south] at (35.100, 8.120) {\small M8};
\node[anchor=north] at (31.500, 2.240) {\small M5};
\node[anchor=north] at (35.100, 2.240) {\small M6};

% Connections to V_LV
\draw (26.690, 11.270) -- (26.690, 11.690);
\draw (M7.S) -- (31.500, 11.690);
\draw (M8.S) -- (35.100, 11.690);

% Diode connection for M13
\draw (M13.G) -- (25.190, 10.290);
\draw (25.190, 10.290) -- (25.190, 9.730);
\draw (25.190, 9.730) -- (26.690, 9.730);
\node[circ] at (26.690, 9.730) {};

% Current source under M13
\draw (26.690, 9.730) to[I] (26.690, 7.280);
\draw (26.690, 7.280) node[ground] {};

% Gate bias distribution line
\draw (25.190, 8.960) -- (33.630, 8.960);
\node[circ] at (25.190, 8.960) {};

% Resistors R17, R18
\draw (30.520, 8.960) to[R=$R_{17}$] (M7.G);
\node[circ] at (30.520, 8.960) {};
\draw (33.630, 8.960) to[R=$R_{18}$] (M8.G);
\node[circ] at (33.630, 8.960) {};

% AC input coupling capacitors C11, C12
\draw (M7.G) to[C=$C_{11}$] (28.940, 6.790);
\node[osquarepole] at (28.940, 6.790) {};
\node[anchor=south] at (28.940, 7.560) {\small $V_{IN1}$};
\draw (M8.G) to[C=$C_{12}$] (32.690, 6.790);
\node[osquarepole] at (32.690, 6.790) {};
\node[anchor=south] at (32.690, 7.560) {\small $V_{IP1}$};

% Output nodes of 2nd stage
\draw (M7.D) -- (M5.D);
\node[circ] at (31.500, 5.250) {};
\draw (M8.D) -- (M6.D);
\node[circ] at (35.100, 5.250) {};

% Feedback network left (C13, R13)
\draw (31.500, 5.250) -- (29.300, 5.250);
\draw (29.300, 5.250) -- (29.300, 5.040);
\draw (29.300, 5.040) to[C=$C_{13}$] (29.300, 3.290);
\draw (29.300, 3.290) to[R=$R_{13}$] (29.300, 1.960);
\draw (29.300, 1.960) -- (29.300, 3.290);
\draw (29.300, 3.290) -- (M5.G);
\node[circ] at (29.300, 5.250) {};
\draw (29.300, 5.250) -- (29.300, 5.740);
\node[osquarepole] at (29.300, 5.740) {};
\node[anchor=east] at (28.500, 5.740) {\small $V_{OP1}$};

% Feedback network right (C14, R14)
\draw (35.100, 5.250) -- (37.650, 5.250);
\draw (37.650, 5.250) -- (37.650, 5.040);
\draw (37.650, 5.040) to[C=$C_{14}$] (37.650, 3.290);
\draw (37.650, 3.290) to[R=$R_{14}$] (37.650, 1.960);
\draw (37.650, 1.960) -- (37.650, 3.290);
\draw (37.650, 3.290) -- (M6.G);
\node[circ] at (37.650, 5.250) {};
\draw (37.650, 5.250) -- (37.650, 5.740);
\node[osquarepole] at (37.650, 5.740) {};
\node[anchor=west] at (38.100, 5.740) {\small $V_{ON1}$};

% Common source connection of M5 and M6 to R10
\draw (M5.S) -- (M6.S);
\node[circ] at (32.690, 2.730) {};
\draw (32.690, 2.730) to[R=$R_{10}$] (32.690, 0.700);
\draw (32.690, 0.700) node[ground] {};
\node[left] at (33.050, 1.120) {\small $I_{R10}$};

% --- Inter-stage Connections (Differential cross-coupling) ---
% Drain of M1/M3 to Gate of M6
\node[circ] at (16.500, 5.460) {};
\draw (16.500, 5.460) -- (33.000, 5.460);
\draw (33.000, 5.460) -- (33.000, 3.290);
\draw (33.000, 3.290) -- (M6.G);

% Drain of M2/M4 to Gate of M5
\node[circ] at (22.500, 4.690) {};
\draw (22.500, 4.690) -- (23.100, 4.690);
\draw (23.100, 4.690) -- (23.100, 1.540);
\draw (23.100, 1.540) -- (30.520, 1.540);
\draw (30.520, 1.540) -- (M5.G);


% --- Stage Labels & Brackets at bottom ---
\draw (1.500, -0.140) -- (1.500, -0.280);
\draw (1.500, -0.280) -- (7.550, -0.280);
\draw (7.550, -0.280) -- (7.550, -0.140);
\node at (4.350, -0.700) {\small \textbf{CMFB}};

\draw (12.000, -0.140) -- (12.000, -0.280);
\draw (12.000, -0.280) -- (18.050, -0.280);
\draw (18.050, -0.280) -- (18.050, -0.140);
\node at (14.850, -0.700) {\small \textbf{$1^{\text{st}}$-stage}};

\draw (25.550, -0.140) -- (25.550, -0.280);
\draw (25.550, -0.280) -- (28.190, -0.280);
\draw (28.190, -0.280) -- (28.190, -0.140);
\node at (27.000, -0.700) {\small \textbf{$2^{\text{nd}}$-stage}};

\end{circuitikz}
