\documentclass{standalone}
\usepackage[siunitx, american]{circuitikz}
\usepackage{tikz}
\usetikzlibrary{calc}
\begin{document}
\begin{circuitikz}[american, scale=1.0, every node/.style={transform shape}]

% V_HV Rail
\draw (1.0, 10.0) -- (14.0, 10.0);
\node[above] at (7.5, 10.0) {$V_{HV}$};

% Thick Oxide Box
\draw[dashed, thick] (1.0, 7.3) rectangle (13.5, 10.6);
\node[anchor=north west] at (1.2, 10.4) {\textbf{Thick Oxide}};

% Thick Oxide Transistors
\node[pmos, emptycircle] (M14) at (2.5, 8.5) {};
\node[above] at (2.5, 9.3) {M14};
\draw (2.5, 9.27) -- (2.5, 10.0);
\node[circ] at (2.5, 10.0) {};

\node[pmos, emptycircle] (M15) at (6.5, 8.5) {};
\node[above] at (6.5, 9.3) {M15};
\draw (6.5, 9.27) -- (6.5, 10.0);
\node[circ] at (6.5, 10.0) {};

\node[pmos, emptycircle] (M16) at (12.5, 8.5) {};
\node[above] at (12.5, 9.3) {M16};
\draw (12.5, 9.27) -- (12.5, 10.0);
\node[circ] at (12.5, 10.0) {};

% M14 Bias and Diode Connection
\draw (2.5, 7.73) to[I] (2.5, 5.0) node[ground]{};
\node[circ] at (2.5, 7.73) {};
\draw (2.5, 7.73) -- (1.52, 7.73) -- (1.52, 8.5);
\node[circ] at (1.52, 8.5) {};
\draw (1.52, 8.5) -- (11.52, 8.5);
\node[circ] at (5.52, 8.5) {};
\node[circ] at (11.52, 8.5) {};

% CMFB Stage (M9, M10)
\node[pmos, emptycircle] (M9) at (4.5, 6.0) {};
\node[right] at (5.5, 6.0) {M9};
\node[pmos, emptycircle, xscale=-1] (M10) at (8.5, 6.0) {};
\node[left] at (7.5, 6.0) {M10};

% M15 drain to M9, M10 sources
\draw (6.5, 7.73) -- (6.5, 7.2);
\draw (4.5, 6.77) -- (4.5, 7.2) -- (8.5, 7.2) -- (8.5, 6.77);
\node[circ] at (6.5, 7.2) {};

% V_CM Terminal
\draw (3.52, 6.0) -- (1.5, 6.0) node[osquarepole]{} node[left=5pt] {$V_{CM}$};

% M11, M12
\node[nmos] (M11) at (4.5, 3.5) {};
\node[right] at (5.5, 3.5) {M11};
\node[nmos, xscale=-1] (M12) at (8.5, 3.5) {};
\node[left] at (7.5, 3.5) {M12};

\draw (4.5, 5.23) -- (4.5, 4.27);
\draw (8.5, 5.23) -- (8.5, 4.27);

\draw (4.5, 4.27) -- (3.52, 4.27) -- (3.52, 3.5);
\draw (8.5, 4.27) -- (9.48, 4.27) -- (9.48, 3.5);

\draw (4.5, 2.73) to[R, l_=$R_{15}$] (4.5, 0.5) node[ground]{};
\draw (8.5, 2.73) to[R, l_=$R_{16}$] (8.5, 0.5) node[ground]{};

% CMFB Label
\draw (4.5, -0.5) -- (4.5, -0.8) -- (8.5, -0.8) -- (8.5, -0.5);
\node[below] at (6.5, -0.8) {\textbf{CMFB}};

% Voltage Divider
\draw (9.48, 6.0) -- (10.5, 6.0);
\node[circ] at (10.5, 6.0) {};
\draw (10.5, 6.0) -- (10.0, 6.0) to[R] (10.0, 7.5) -- (10.5, 7.5);
\draw (10.5, 6.0) -- (11.0, 6.0) to[C] (11.0, 7.5) -- (10.5, 7.5);
\node[above] at (10.5, 7.5) {$V_{OP1}$};

\draw (10.5, 6.0) -- (10.0, 6.0) to[R] (10.0, 4.5) -- (10.5, 4.5);
\draw (10.5, 6.0) -- (11.0, 6.0) to[C] (11.0, 4.5) -- (10.5, 4.5);
\node[below] at (10.5, 4.5) {$V_{ON1}$};

% 1st-stage
\node[pmos, emptycircle] (M1) at (14.5, 6.0) {};
\node[above] at (13.0, 6.3) {M1};
\node[pmos, emptycircle, xscale=-1] (M2) at (17.5, 6.0) {};
\node[above] at (19.0, 6.3) {M2};

% M16 drain to M1, M2 sources
\draw (12.5, 7.73) -- (12.5, 7.2) -- (17.5, 7.2) -- (17.5, 6.77);
\draw (14.5, 7.2) -- (14.5, 6.77);
\node[circ] at (14.5, 7.2) {};

% V_IP1, V_IN1 Terminals (1st Stage)
\draw (13.52, 6.0) -- (12.0, 6.0) node[osquarepole]{} node[left=5pt] {$V_{IP1}$};
\draw (18.48, 6.0) -- (19.8, 6.0) node[osquarepole]{} node[right=5pt] {$V_{IN1}$};

% M3, M4
\node[nmos] (M3) at (14.5, 3.5) {};
\node[left] at (13.5, 3.5) {M3};
\node[nmos, xscale=-1] (M4) at (17.5, 3.5) {};
\node[right] at (18.5, 3.5) {M4};

\draw (14.5, 5.23) -- (14.5, 4.27);
\draw (17.5, 5.23) -- (17.5, 4.27);

\draw (14.5, 2.73) to[R, l_=$R_{11}$] (14.5, 0.5) node[ground]{};
\draw (17.5, 2.73) to[R, l_=$R_{12}$] (17.5, 0.5) node[ground]{};

% Bias from M12
\draw (9.48, 3.5) -- (18.48, 3.5);
\node[circ] at (9.48, 3.5) {};
\node[circ] at (13.52, 3.5) {};

% 1st-stage Label
\draw (14.5, -0.5) -- (14.5, -0.8) -- (17.5, -0.8) -- (17.5, -0.5);
\node[below] at (16.0, -0.8) {\textbf{1st-stage}};

% V_LV Rail
\draw (20.0, 10.0) -- (33.0, 10.0);
\node[above] at (26.5, 10.0) {$V_{LV}$};

% 2nd-stage
\node[pmos, emptycircle] (M13) at (21.5, 8.5) {};
\node[left] at (20.0, 8.5) {M13};
\draw (21.5, 9.27) -- (21.5, 10.0);
\node[circ] at (21.5, 10.0) {};

\draw (21.5, 7.73) to[I] (21.5, 6.5) node[ground]{};
\node[circ] at (21.5, 7.73) {};
\draw (21.5, 7.73) -- (20.52, 7.73) -- (20.52, 8.5);
\draw (20.52, 8.0) -- (30.48, 8.0);
\node[circ] at (20.52, 8.0) {};

\node[pmos, emptycircle] (M7) at (25.5, 6.0) {};
\node[right] at (26.5, 6.0) {M7};
\draw (25.5, 6.77) -- (25.5, 10.0);
\node[circ] at (25.5, 10.0) {};

\node[pmos, emptycircle, xscale=-1] (M8) at (29.5, 6.0) {};
\node[left] at (28.5, 6.0) {M8};
\draw (29.5, 6.77) -- (29.5, 10.0);
\node[circ] at (29.5, 10.0) {};

% R17, R18
\draw (24.52, 8.0) -- (23.5, 8.0) to[R, l=$R_{17}$] (23.5, 6.0) -- (24.52, 6.0);
\node[circ] at (24.52, 8.0) {};
\node[circ] at (24.52, 6.0) {};

\draw (30.48, 8.0) -- (31.5, 8.0) to[R, l=$R_{18}$] (31.5, 6.0) -- (30.48, 6.0);
\node[circ] at (30.48, 8.0) {};
\node[circ] at (30.48, 6.0) {};

% C11, C12
\draw (24.52, 6.0) to[C, l=$C_{11}$] (22.5, 6.0) node[osquarepole]{} node[left=5pt] {$V_{IN1}$};
\draw (30.48, 6.0) to[C, l=$C_{12}$] (32.5, 6.0) node[osquarepole]{} node[right=5pt] {$V_{IP1}$};

% M5, M6
\node[nmos] (M5) at (25.5, 2.5) {};
\node[right] at (26.5, 2.5) {M5};
\node[nmos, xscale=-1] (M6) at (29.5, 2.5) {};
\node[left] at (28.5, 2.5) {M6};

\draw (25.5, 5.23) -- (25.5, 3.27);
\draw (29.5, 5.23) -- (29.5, 3.27);

\node[left] at (25.5, 4.5) {$V_{OP1}$};
\node[right] at (29.5, 4.5) {$V_{ON1}$};

\draw (25.5, 1.73) -- (25.5, 1.2);
\draw (29.5, 1.73) -- (29.5, 1.2);
\draw (25.5, 1.2) -- (29.5, 1.2);

\draw (27.5, 1.2) to[R, l_=$R_{10}$, i>=$I_{R10}$] (27.5, -0.5) node[ground]{};
\node[circ] at (27.5, 1.2) {};

% RC Networks
\draw (25.5, 3.8) -- (23.5, 3.8) to[C, l=$C_{13}$] (23.5, 2.8) to[R, l=$R_{13}$] (23.5, 1.8) -- (24.52, 1.8) -- (24.52, 2.5);
\node[circ] at (25.5, 3.8) {};
\node[circ] at (24.52, 2.5) {};

\draw (29.5, 3.8) -- (31.5, 3.8) to[C, l_=$C_{14}$] (31.5, 2.8) to[R, l_=$R_{14}$] (31.5, 1.8) -- (30.48, 1.8) -- (30.48, 2.5);
\node[circ] at (29.5, 3.8) {};
\node[circ] at (30.48, 2.5) {};

% Cross Connections
\draw (14.5, 4.6) -- (30.48, 4.6) -- (30.48, 2.5);
\node[circ] at (14.5, 4.6) {};

\draw (17.5, 4.5) -- (24.52, 4.5) -- (24.52, 2.5);
\node[circ] at (17.5, 4.5) {};

% 2nd-stage Label
\draw (25.5, -1.0) -- (25.5, -1.3) -- (29.5, -1.3) -- (29.5, -1.0);
\node[below] at (27.5, -1.3) {\textbf{2nd-stage}};

